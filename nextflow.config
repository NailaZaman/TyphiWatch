/*
 * TyphiWatch - Nextflow configuration
 * Run from the repository root:
 *   nextflow run workflows/main.nf -profile docker
 */

manifest {
    name            = 'TyphiWatch'
    author          = 'NAILA_ZAMAN'
    description     = 'Bacterial WGS surveillance workflow for Salmonella Typhi: QC, assembly, typing, AMR and phylogeny'
    version         = '0.1.0'
    nextflowVersion = '>=23.10.0'
}

params {
    // ---- Input / output -------------------------------------------------
    samplesheet        = 'data/metadata/samplesheet.csv'   // sample,fastq_1,fastq_2 (paths or URLs)
    reference          = 'data/reference/CT18_AL513382.1.gbk'
    outdir             = 'results'

    // ---- Read QC --------------------------------------------------------
    min_read_length    = 50

    // ---- Assembly QC gate (samples failing are excluded downstream) -----
    min_genome_size    = 4300000      // S. Typhi CT18 chromosome is ~4.8 Mb
    max_genome_size    = 5500000
    min_n50            = 20000

    // ---- Typing ---------------------------------------------------------
    mlst_scheme        = null         // null = let mlst auto-detect
    run_seqsero2       = true
    run_genotyphi      = true         // Mykrobe typhi panel (GenoTyphi genotypes)

    // ---- Resistance -----------------------------------------------------
    amr_organism       = 'Salmonella'
    amrfinder_db       = null         // path to an existing AMRFinderPlus DB, or null to download

    // ---- Phylogeny ------------------------------------------------------
    run_phylogeny      = true
    min_phylo_samples  = 4            // IQ-TREE bootstrap needs >= 4 sequences
    snippy_mincov      = 10
    snippy_minfrac     = 0.9
    iqtree_model       = 'GTR+G+ASC'
    iqtree_bootstraps  = 1000

    // ---- Containers (biocontainers). If a pull fails, find the right tag at
    //      https://quay.io/repository/biocontainers/<tool>?tab=tags and edit here.
    containers {
        fastqc      = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
        fastp       = 'quay.io/biocontainers/fastp:0.23.4--h5f740d0_0'
        multiqc     = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
        spades      = 'quay.io/biocontainers/spades:3.15.5--h95f258a_1'
        quast       = 'quay.io/biocontainers/quast:5.2.0--py39pl5321h4e691d4_3'
        mlst        = 'quay.io/biocontainers/mlst:2.23.0--hdfd78af_1'
        seqsero2    = 'quay.io/biocontainers/seqsero2:1.2.1--py_0'
        mykrobe     = 'quay.io/biocontainers/mykrobe:0.13.0--py39hb185606_5'
        amrfinder   = 'quay.io/biocontainers/ncbi-amrfinderplus:3.12.8--h283d18e_0'
        snippy      = 'quay.io/biocontainers/snippy:4.6.0--hdfd78af_4'
        snp_sites   = 'quay.io/biocontainers/snp-sites:2.5.1--hed695b0_0'
        snp_dists   = 'quay.io/biocontainers/snp-dists:0.8.2--h5bf99c6_0'
        iqtree      = 'quay.io/biocontainers/iqtree:2.3.4--h21ec9f0_0'
    }
}

process {
    cpus   = 2
    memory = '4 GB'
    time   = '6h'

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: process_low    { cpus = 2; memory = { 4.GB  * task.attempt } }
    withLabel: process_medium { cpus = 4; memory = { 8.GB  * task.attempt } }
    withLabel: process_high   { cpus = 8; memory = { 16.GB * task.attempt } }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled     = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    conda {
        conda.enabled  = true
        conda.useMamba = true
        docker.enabled = false
    }
    // Resource-limited profile for a laptop / small workstation: -profile docker,laptop
    laptop {
        process {
            withLabel: process_low    { cpus = 2; memory = '4 GB' }
            withLabel: process_medium { cpus = 4; memory = '8 GB' }
            withLabel: process_high   { cpus = 4; memory = '12 GB' }
        }
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }

workflow.onComplete = {
    println """
    ------------------------------------------------------------
    TyphiWatch ${workflow.success ? 'finished' : 'FAILED'} (${workflow.duration})
    Results : ${params.outdir}
    Next    : python scripts/resistance_summary.py
              python scripts/visualization.py
    ------------------------------------------------------------
    """.stripIndent()
}
